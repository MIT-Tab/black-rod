#!/usr/bin/env bash
# Usage: dev-up [--fresh] [--empty]
# Starts webpack --watch + runserver for this worktree in the background and returns once the
# site answers. First run migrates private SQLite and loads dev_fixtures. Login: tab / password.
#   --fresh  rebuild only this checkout's private dev DB
#   --empty  skip fixtures, create only the local tab login
. "$(dirname "$0")/_env.sh"
cd "$BR_ROOT"
set -uo pipefail
[ -x "$BR_PYTHON" ] && [ -x "$BR_ROOT/node_modules/.bin/webpack" ] || {
  echo "Missing dependencies; run start-task or install the documented environments first." >&2
  exit 1
}

fresh=0
empty=0
for arg in "$@"; do
  case "$arg" in
    --fresh) fresh=1 ;;
    --empty) empty=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

fail() {
  "$BR_SCRIPTS/dev-down" >/dev/null 2>&1
  tail -n 40 "$1" | cut -c1-300
  echo "dev-up failed; full log: $1" >&2
  exit 1
}

"$BR_SCRIPTS/dev-down" >/dev/null 2>&1
setup_log="$BR_STATE/dev-setup.log"
: >"$setup_log"

if [ "$fresh" = 1 ]; then
  rm -f "$BR_STATE/dev.sqlite3" "$BR_STATE/dev.sqlite3-wal" "$BR_STATE/dev.sqlite3-shm" "$BR_STATE/seeded"
fi
"$BR_PYTHON" manage.py migrate --noinput >>"$setup_log" 2>&1 || fail "$setup_log"
if [ ! -f "$BR_STATE/seeded" ]; then
  if [ "$empty" = 0 ]; then
    BR_LOADING_FIXTURE=1 "$BR_PYTHON" manage.py loaddata dev_fixtures >>"$setup_log" 2>&1 || fail "$setup_log"
  fi
  # Fixtures contain sanitized password hashes; explicitly set the local login.
  "$BR_PYTHON" manage.py shell -c "from django.contrib.auth import get_user_model; u, _ = get_user_model().objects.get_or_create(username='tab'); u.is_staff = True; u.is_superuser = True; u.set_password('password'); u.save()" >>"$setup_log" 2>&1 || fail "$setup_log"
  touch "$BR_STATE/seeded"
fi

port="$BR_PORT"
last_port=$((port + 100))
while ! "$BR_PYTHON" -c 'import socket, sys; s = socket.socket(); s.bind(("127.0.0.1", int(sys.argv[1]))); s.close()' "$port" 2>/dev/null; do
  port=$((port + 1))
  [ "$port" -le "$last_port" ] || { echo "No free dev port found" >&2; exit 1; }
done
echo "$port" >"$BR_STATE/port"

started="$(date +%s)"
# Python's process/session API works on Linux and macOS without GNU setsid/nohup.
"$BR_PYTHON" - "$BR_STATE" "$port" <<'PYTHON'
import os
import subprocess
import sys
from pathlib import Path
state = Path(sys.argv[1])
commands = {
    "webpack": ["./node_modules/.bin/webpack", "--config", "webpack.config.js", "--watch"],
    "server": [os.environ["BR_PYTHON"], "manage.py", "runserver", f"127.0.0.1:{sys.argv[2]}", "--noreload"],
}
for name, command in commands.items():
    with (state / f"{name}.log").open("w") as log:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                   start_new_session=True,
                                   env={**os.environ, "NODE_ENV": "development", "DEBUG": "1",
                                        "SILK_ENABLED": "0"})
    (state / f"{name}.pid").write_text(str(process.pid))
PYTHON

for _ in $(seq 1 120); do
  stats_ready=0
  if [ -f webpack-stats.json ] && [ "$("$BR_PYTHON" -c 'import os; print(int(os.path.getmtime("webpack-stats.json")))')" -ge "$started" ] &&
    grep -q '"status": *"done"' webpack-stats.json; then
    stats_ready=1
  fi
  code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/" || true)"
  if [ "$stats_ready" = 1 ] && [[ $code =~ ^(200|302)$ ]]; then
    echo "dev server: http://127.0.0.1:$port  (login tab / password)"
    echo "DB: $BR_STATE/dev.sqlite3   logs: $BR_STATE/server.log, $BR_STATE/webpack.log   stop: dev-down"
    exit 0
  fi
  grep -q 'ERROR in' "$BR_STATE/webpack.log" 2>/dev/null && fail "$BR_STATE/webpack.log"
  kill -0 "$(cat "$BR_STATE/server.pid")" 2>/dev/null || fail "$BR_STATE/server.log"
  sleep 1
done
echo "timed out waiting for server/webpack (http $code)" >&2
fail "$BR_STATE/server.log"
