#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

export BLACK_ROD_DATABASE_URL="${BLACK_ROD_DATABASE_URL:-sqlite://apda/db.sqlite3?mode=rw}"
export BLACK_ROD_BIND="${BLACK_ROD_BIND:-0.0.0.0:8000}"

npm run watch &
webpack_pid=$!
trap 'kill "$webpack_pid" 2>/dev/null || true' EXIT

cargo +1.94.0 run --locked --manifest-path rust/Cargo.toml -- serve
